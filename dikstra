#include <iostream>
using namespace std;

int main() {
    int n, cost[10][10], dist[10], visited[10] = {0};
    int src;

    cout << "Enter number of vertices: ";
    cin >> n;

    cout << "Enter cost matrix:\n";
    for(int i = 0; i < n; i++) {
        for(int j = 0; j < n; j++) {
            cin >> cost[i][j];
            if(cost[i][j] == 0)
                cost[i][j] = 9999;
        }
    }

    cout << "Enter source vertex: ";
    cin >> src;

    for(int i = 0; i < n; i++)
        dist[i] = cost[src][i];

    dist[src] = 0;
    visited[src] = 1;

    for(int count = 1; count < n; count++) {
        int min = 9999, u = -1;

        for(int i = 0; i < n; i++) {
            if(!visited[i] && dist[i] < min) {
                min = dist[i];
                u = i;
            }
        }

        if(u == -1) break;

        visited[u] = 1;

        for(int v = 0; v < n; v++) {
            if(!visited[v] && dist[u] + cost[u][v] < dist[v]) {
                dist[v] = dist[u] + cost[u][v];
            }
        }
    }

    cout << "Shortest distances:\n";
    for(int i = 0; i < n; i++)
        cout << src << " to " << i << " = " << dist[i] << endl;

    return 0;
}


